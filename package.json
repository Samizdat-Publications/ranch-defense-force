{
  "name": "ranch-defense-force",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "Wave-based bullet-heaven set on a farm outside Canton, Ohio.",
  "scripts": {
    "dev": "vite",
    "build": "npm run atlas && tsc --noEmit && tsc -p tools --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "atlas": "vite-node tools/build-atlas.ts",
    "inspect": "vite-node tools/inspect-sheet.ts --",
    "typecheck": "tsc --noEmit && tsc -p tools --noEmit"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vitest": "^2.1.8"
  }
}
