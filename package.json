{
  "name": "ranch-defense-force",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "Wave-based bullet-heaven set on a farm outside Canton, Ohio.",
  "scripts": {
    "dev": "vite",
    "build": "npm run atlas && tsc --noEmit && tsc -p tools --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "atlas": "npm run characters && vite-node tools/build-atlas.ts",
    "conform": "vite-node tools/conform-fx.ts -- --write",
    "music": "vite-node tools/fetch-music.ts --",
    "sfx": "vite-node tools/fetch-sfx.ts --",
    "audio": "npm run sfx && npm run music",
    "balance": "vite-node tools/balance.ts --",
    "inspect": "vite-node tools/inspect-sheet.ts --",
    "pitch": "vite-node tools/sprite-pitch.ts --",
    "shot": "vite-node tools/screenshot.ts --",
    "typecheck": "tsc --noEmit && tsc -p tools --noEmit",
    "range": "vite-node tools/weapon-range.ts --",
    "zoom": "vite-node tools/zoom-check.ts --",
    "characters": "vite-node tools/make-character.ts --"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vitest": "^2.1.8"
  }
}
