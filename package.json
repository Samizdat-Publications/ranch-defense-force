{
  "name": "ranch-defense-force",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "Wave-based bullet-heaven set on a farm outside Canton, Ohio.",
  "scripts": {
    "dev": "vite",
    "build": "npm run atlas && tsc --noEmit && tsc -p tools --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "atlas": "npm run characters && vite-node tools/build-atlas.ts",
    "conform": "vite-node tools/conform-fx.ts -- --write",
    "music": "vite-node tools/fetch-music.ts --",
    "sfx": "vite-node tools/fetch-sfx.ts --",
    "audio": "npm run sfx && npm run music",
    "balance": "vite-node tools/balance.ts --",
    "inspect": "vite-node tools/inspect-sheet.ts --",
    "inventory": "vite-node tools/pixellab-inventory.ts --",
    "catalog": "vite-node tools/asset-catalog.ts --",
    "pitch": "vite-node tools/sprite-pitch.ts --",
    "shot": "vite-node tools/screenshot.ts --",
    "typecheck": "tsc --noEmit && tsc -p tools --noEmit",
    "range": "vite-node tools/weapon-range.ts --",
    "zoom": "vite-node tools/zoom-check.ts --",
    "characters": "vite-node tools/make-character.ts --",
    "pixellab": "vite-node tools/pixellab.ts --",
    "anchor": "vite-node tools/char-anchor.ts --",
    "cut": "vite-node tools/pixellab-cut.ts --",
    "fetch": "vite-node tools/pixellab-fetch.ts --",
    "object": "vite-node tools/pixellab-object.ts --",
    "mapobject": "vite-node tools/pixellab-mapobject.ts --",
    "rmbg": "vite-node tools/pixellab-rmbg.ts --",
    "animal": "vite-node tools/animal-check.ts --",
    "anim": "vite-node tools/pixellab-anim.ts --",
    "animate": "vite-node tools/pixellab-animate.ts --",
    "character": "vite-node tools/pixellab-character.ts --",
    "tileset": "vite-node tools/pixellab-tileset.ts --",
    "frames": "vite-node tools/pixellab-frames.ts --",
    "objman": "vite-node tools/object-manifest.ts --",
    "contact": "vite-node tools/atlas-contact.ts --",
    "contactdir": "vite-node tools/contact-dir.ts --",
    "scale": "vite-node tools/measure-scale.ts --",
    "pick": "vite-node tools/pick-props.ts --",
    "strips": "vite-node tools/export-strips.ts --",
    "pens": "vite-node tools/measure-pens.ts --",
    "clips": "vite-node tools/check-clips.ts --",
    "decard": "vite-node tools/decard.ts --",
    "recolour": "vite-node tools/recolour-sheet.ts --",
    "placements": "vite-node tools/extract-placements.ts --",
    "scene": "vite-node tools/scene-shot.ts --",
    "play": "vite-node tools/play.ts --"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "playwright": "^1.62.1",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vitest": "^2.1.8"
  }
}
