# Dependencies
node_modules/
package-lock.json.bak

# Build output
dist/
build/
.vite/
.cache/

# Generated by tools/. The atlas is built from assets/ on demand, as one
# manifest plus a page image per 2048x2048 sheet.
public/atlas-*.png
public/atlas.png
public/atlas.json
public/ui/
# Generated by `npm run music` (Lyria). Regenerate from the prompts in
# src/content/audio.json rather than committing audio.
# public/audio/ used to be ignored (regenerated by `npm run music`/`npm run sfx`). It
# is committed now: the music is CC-0, the effects are this project's own ElevenLabs
# output, and the deploy has no API keys — so an ignored directory shipped a
# silent game to GitHub Pages (session 22).
tools/shot.png
tools/_*

# Installers / binaries (not usable by agents, license-restricted)
*.exe
*.msi

# Editor / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini
*.swp

# Env
.env
.env.local

# Claude Code local machine settings
.claude/settings.local.json
# Scratch state written by MCP servers into the project. It is machine-local and
# has nothing to do with the game -- a healthcare plugin's sqlite files landed in
# a commit here on 2026-09-03 because a `git add -A` swept the whole tree.
.claude/data/
.claude/worktrees/

# API keys. PixelLab, ElevenLabs and Gemini keys are read from the environment
# and must never land in the repo — this is a public repository.
.env
.env.*
*.key

# Holds a live PixelLab key. .mcp.json.example is the committed template.
.mcp.json
.tmp/

# Playthrough output: hundreds of PNGs per run, regenerated by `npm run play`.
tools/play/
