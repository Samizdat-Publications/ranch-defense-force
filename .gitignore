# Dependencies
node_modules/
package-lock.json.bak

# Build output
dist/
build/
.vite/
.cache/

# Generated by tools/. The atlas is built from assets/ on demand.
public/atlas.png
public/atlas.json
public/ui/
# Generated by `npm run music` (Lyria). Regenerate from the prompts in
# src/content/audio.json rather than committing audio.
public/audio/
tools/shot.png
tools/_*
tools/maps/

# docs/progress/ is DELIBERATELY NOT IGNORED. It is the screenshot archive
# and the whole point is that it survives — sixteen sessions left no visual
# record because every shot went to a gitignored path. See tools/snap.ts.
docs/progress/_tmp/

# Installers / binaries (not usable by agents, license-restricted)
*.exe
*.msi

# Editor / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini
*.swp

# Env
.env
.env.local

# Claude Code local machine settings
.claude/settings.local.json

# API keys. PixelLab, ElevenLabs and Gemini keys are read from the environment
# and must never land in the repo — this is a public repository.
.env
.env.*
*.key

# Holds a live PixelLab key. .mcp.json.example is the committed template.
.mcp.json
.tmp/
