{
  "$comment": [
    "Source-of-truth asset manifest. The ONLY place a file path appears.",
    "tools/build-atlas.ts reads this, slices, trims, records pivots, and packs",
    "public/atlas.png + atlas.json. The game never reads assets/ at runtime.",
    "Rename to sprites.json and extend. Paths are relative to the repo root."
  ],
  "scale": 32,
  "humanoidGrid": {
    "cols": 56,
    "rows": 22,
    "cell": 32,
    "assertSize": [
      1792,
      704
    ]
  },
  "humanoidRows": {
    "$comment": "Only slice the rows the game uses. Confirm indices against Farmer_Generator_Pieces/ANIMATIONS_GUIDE_TOOLS.png before trusting these.",
    "idle": {
      "row": 0,
      "frames": 4,
      "fps": 6
    },
    "walk": {
      "row": 1,
      "frames": 18,
      "fps": 12
    },
    "run": {
      "row": 2,
      "frames": 18,
      "fps": 14
    },
    "hit": {
      "row": 3,
      "frames": 1
    },
    "death": {
      "row": 3,
      "frames": 1,
      "note": "no death frames needed — spin + scale to zero in code"
    }
  },
  "humanoids": {
    "farmer": {
      "file": "assets/generated/farmer.png"
    },
    "female_farmer": {
      "file": "assets/generated/Female Farmer.png"
    },
    "zombie": {
      "file": "assets/generated/Zombie.png"
    },
    "zombie2": {
      "file": "assets/generated/zombie2.png"
    },
    "acid_zombie": {
      "file": "assets/generated/Acid Zombie.png"
    },
    "gas_enemy": {
      "file": "assets/generated/gas enemy.png"
    },
    "gas_enemy2": {
      "file": "assets/generated/gas enemy2.png"
    }
  },
  "animals": {
